# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=

# Groq — reserved for later phases (intent parsing, patch generation).
# Not used by the indexer/embedder: Groq serves chat/completion models,
# it has no embeddings endpoint.
GROQ_API_KEY=

# GitHub — Phase 5 (git/PR integration), deferred for now.
GITHUB_TOKEN=
GITHUB_REPO=

# Embeddings — no paid backend wired in yet. Default is a local,
# deterministic hashing-trick embedder (indexer/embedder.py), no API key
# needed. Swap in a real backend later and point EMBEDDING_BACKEND at it.
EMBEDDING_BACKEND=hashing
EMBED_DIM=512
